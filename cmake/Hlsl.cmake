# Embeds the Direct3D HLSL shaders into the library.
#
# The shaders are compiled at runtime by D3DCompile, so the source has to
# reach the DLL somehow. Embedding it as a string constant keeps the engine
# free of runtime file dependencies: no shader directory next to the binary.

set(APORIA_HLSL_SOURCE "${CMAKE_CURRENT_SOURCE_DIR}/shaders/dx12/engine.hlsl")
set(APORIA_HLSL_HEADER "${CMAKE_CURRENT_BINARY_DIR}/generated/AporiaHlslShaders.hpp")

function(aporia_embed_hlsl source header)
    if(NOT EXISTS "${source}")
        message(FATAL_ERROR "HLSL shader source not found: ${source}")
    endif()
    file(READ "${source}" content)
    # A raw string literal ends at the delimiter, so the source must not
    # contain it.
    set(delim ")APORIA_HLSL\"")
    string(FIND "${content}" "${delim}" found)
    if(NOT found EQUAL -1)
        message(FATAL_ERROR "HLSL source contains the raw string delimiter")
    endif()

    # A single string literal cannot be longer than the limit the compiler
    # imposes, so the source is split into chunks that are joined at runtime.
    # The split is done by offset instead of by lines: the shader source holds
    # semicolons, and a semicolon is a list separator in CMake.
    string(LENGTH "${content}" total)
    set(chunkSize 2000)
    set(offset 0)
    set(body "")
    while(offset LESS total)
        math(EXPR remaining "${total} - ${offset}")
        if(remaining GREATER chunkSize)
            set(size ${chunkSize})
        else()
            set(size ${remaining})
        endif()
        string(SUBSTRING "${content}" ${offset} ${size} chunk)
        set(body "${body}R\"APORIA_HLSL(${chunk})APORIA_HLSL\",\n")
        math(EXPR offset "${offset} + ${size}")
    endwhile()

    file(WRITE "${header}"
"// Generated by cmake/Hlsl.cmake from ${source}. Do not edit.
#pragma once

#include <cstddef>
#include <string>

namespace aporia::generated {

// The shader source, split into chunks: one string literal cannot hold the
// whole file. Use aporiaEngineHlsl() to get it back as one string.
inline constexpr const char* kAporiaEngineHlslChunks[] = {
${body}};

inline constexpr std::size_t kAporiaEngineHlslChunkCount =
    sizeof(kAporiaEngineHlslChunks) / sizeof(kAporiaEngineHlslChunks[0]);

inline std::string aporiaEngineHlsl()
{
    std::string source;
    source.reserve(64u * 1024u);
    for (std::size_t index = 0; index < kAporiaEngineHlslChunkCount; ++index) {
        source += kAporiaEngineHlslChunks[index];
    }
    return source;
}

}  // namespace aporia::generated
")
endfunction()

aporia_embed_hlsl("${APORIA_HLSL_SOURCE}" "${APORIA_HLSL_HEADER}")

# Re-run CMake when the shader changes so the embedded copy stays in sync.
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${APORIA_HLSL_SOURCE}")

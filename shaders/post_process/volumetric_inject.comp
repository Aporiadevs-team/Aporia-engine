#version 450

// Froxel volumetric fog: one invocation per froxel of a frustum-aligned grid.
// Injects in-scattered sunlight (rgb) and extinction (a); the tonemap pass reads
// the grid along each view ray to the stored scene depth.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba16f) uniform image3D froxelImage;
layout(set = 0, binding = 1) uniform sampler2D shadowMap;

layout(set = 0, binding = 2) uniform InjectParams {
    mat4 invViewProj;    // clip -> world (column-major)
    mat4 sunViewProj;    // world -> sun clip (column-major)
    vec4 cameraPosition; // xyz eye, w unused
    vec4 sunDirection;   // xyz toward the sun, w intensity (0 night .. 1 noon)
    vec4 sunColor;       // rgb sunlight colour
    vec4 fogParams;      // x near, y far, z density, w height falloff (1/m)
    vec4 gridParams;     // x phaseG, y noiseScale, z groundZ, w time (seconds)
    // Up to 4 point lights that scatter light through fog (cone/god-ray effect).
    // Each: position.xyz + type (1.0 = point).
    vec4 lightPosition[4];
    vec4 lightColor[4];  // rgb + intensity
    vec4 lightParams[4]; // x radius, y softness
} p;

const float PI = 3.14159265;

// Cheap smooth 3D value noise (hash of the integer lattice, smoothstep blend).
float hash13(vec3 p3) {
    p3 = fract(p3 * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
}

float noise3(vec3 x) {
    vec3 i = floor(x);
    vec3 f = fract(x);
    f = f * f * (3.0 - 2.0 * f);
    float a = hash13(i + vec3(0.0, 0.0, 0.0));
    float b = hash13(i + vec3(1.0, 0.0, 0.0));
    float c = hash13(i + vec3(0.0, 1.0, 0.0));
    float d = hash13(i + vec3(1.0, 1.0, 0.0));
    float e = hash13(i + vec3(0.0, 0.0, 1.0));
    float g = hash13(i + vec3(1.0, 0.0, 1.0));
    float h = hash13(i + vec3(0.0, 1.0, 1.0));
    float k = hash13(i + vec3(1.0, 1.0, 1.0));
    return mix(mix(mix(a, b, f.x), mix(c, d, f.x), f.y),
               mix(mix(e, g, f.x), mix(h, k, f.x), f.y), f.z);
}

float henyeyGreenstein(float cosAngle, float g) {
    float g2 = g * g;
    return (1.0 - g2) / (4.0 * PI * pow(max(1.0 + g2 - 2.0 * g * cosAngle, 1.0e-4), 1.5));
}

void main() {
    const ivec3 dims = imageSize(froxelImage);
    const ivec3 cell = ivec3(gl_GlobalInvocationID);
    if (any(greaterThanEqual(cell, dims))) {
        return;
    }

    // Froxel centre -> screen uv (matches the tonemap integrator) and an
    // exponentially distributed world distance (small cells up close).
    const vec2 uv = (vec2(cell.xy) + 0.5) / vec2(dims.xy);
    const float slice = (float(cell.z) + 0.5) / float(dims.z);
    const float near = p.fogParams.x;
    const float far = p.fogParams.y;
    const float distance = near * pow(far / near, slice);

    // World-space ray for this screen pixel, then the sample point on it.
    const vec2 ndc = vec2(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0);
    vec4 nearPoint = p.invViewProj * vec4(ndc, 0.0, 1.0);
    nearPoint /= nearPoint.w;
    vec4 farPoint = p.invViewProj * vec4(ndc, 1.0, 1.0);
    farPoint /= farPoint.w;
    const vec3 rayDir = normalize(farPoint.xyz - nearPoint.xyz);
    const vec3 worldPos = p.cameraPosition.xyz + rayDir * distance;

    // Exponential height falloff plus animated noise so fog is not a flat slab.
    const float height = max(worldPos.z - p.gridParams.z, 0.0);
    float density = p.fogParams.z * exp(-p.fogParams.w * height);
    const float noise = noise3(worldPos * p.gridParams.y + vec3(0.0, 0.0, p.gridParams.w * 0.25));
    density *= mix(0.55, 1.35, noise);
    if (density <= 1.0e-4) {
        imageStore(froxelImage, cell, vec4(0.0));
        return;
    }

    // Sun visibility through the shadow map.
    float visibility = 1.0;
    const vec4 shadowClip = p.sunViewProj * vec4(worldPos, 1.0);
    if (shadowClip.w > 0.0) {
        vec3 shadowCoord = shadowClip.xyz / shadowClip.w;
        shadowCoord.xy = shadowCoord.xy * 0.5 + 0.5;
        if (all(greaterThan(shadowCoord.xy, vec2(0.0))) &&
            all(lessThan(shadowCoord.xy, vec2(1.0)))) {
            const float mapDepth = texture(shadowMap, shadowCoord.xy).r;
            visibility = (shadowCoord.z - 0.002 <= mapDepth) ? 1.0 : 0.15;
        }
    }

    const vec3 sunDir = normalize(p.sunDirection.xyz);
    const float phase = henyeyGreenstein(dot(rayDir, sunDir), clamp(p.gridParams.x, -0.9, 0.9));
    // Scattering coefficient * incident radiance (per unit length): the density
    // must be folded in here, otherwise every froxel scatters like opaque air.
    vec3 scatter = p.sunColor.rgb * (p.sunDirection.w * phase * visibility) * density;

    // Point light volumetric scattering: each lamp creates a cone/god-ray effect
    // through fog. Uses distance attenuation + phase function for the light.
    const int pointLightCount = 4;
    for (int li = 0; li < pointLightCount; ++li) {
        vec4 lpos = p.lightPosition[li];
        if (lpos.w < 0.5) continue; // not a point light
        vec3 toLight = lpos.xyz - worldPos;
        float d = length(toLight);
        if (d > p.lightParams[li].x * 2.0) continue; // outside useful range
        vec3 ldir = toLight / max(d, 1e-4);
        // Inverse-square-ish attenuation
        float atten = p.lightParams[li].x * p.lightParams[li].x / (d * d + 0.1);
        atten *= max(1.0 - d / (p.lightParams[li].x * 1.5), 0.0);
        atten = pow(atten, max(p.lightParams[li].y, 0.01));
        float intensity = max(p.lightColor[li].w, 0.01);
        vec3 lcol = p.lightColor[li].rgb;
        // Simple isotropic scatter (no directionality for point lights in fog).
        // Adds visible light shafts where fog is dense.
        scatter += lcol * atten * intensity * density * 0.12;
    }

    imageStore(froxelImage, cell, vec4(scatter, density));
}
